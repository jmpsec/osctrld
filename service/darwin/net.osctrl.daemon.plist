<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs osctrld as root. The binary, the configuration and /Library/osctrld must be
  owned by root:wheel and writable only by root (binary 0755, configuration 0600).
  Do not point this at /usr/local or a Homebrew prefix: on Intel Macs those belong to
  the Homebrew user, who could then replace them and run code as root.
-->
<plist version="1.0">
<dict>
  <key>KeepAlive</key>
  <true/>
  <key>Disabled</key>
  <false/>
  <key>Label</key>
  <string>net.osctrl.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/osctrld/osctrld</string>
    <string>service</string>
    <string>--config=/Library/osctrld/osctrld.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/osctrld.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/osctrld.log</string>
</dict>
</plist>

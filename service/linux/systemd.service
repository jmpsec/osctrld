[Unit]
Description=osctrld, keeps osquery configured from osctrl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root: osctrld writes the osquery flagfile, certificate and extensions, and
# restarts osqueryd when they change
User=root
ExecStart=/usr/bin/osctrld service --config=/etc/osctrld/osctrld.yaml
Restart=on-failure
RestartSec=10
SyslogIdentifier=osctrld

[Install]
WantedBy=multi-user.target
